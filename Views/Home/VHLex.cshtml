@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!-- ─── PAGE HERO ─── -->
<section id="section-home" class="page-hero">
    <div class="page-hero-bg"><img src="~/img/foto1.jpg" alt="Litigation"></div>
    <div class="page-hero-overlay"></div>
    <div class="page-hero-content">
        <div class="page-hero-eyebrow" data-i18n="hero_eyebrow">Practice Area</div>
        <h1 class="page-hero-title" data-i18n-html="hero_title">Litigation &amp; <cite>Legal Representation</cite></h1>
        <p class="page-hero-sub" data-i18n="hero_sub">High-stakes dispute resolution backed by 23 years of experience — from local courts to international arbitration forums.</p>
    </div>
</section>

<!-- ─── BREADCRUMB ─── -->
<div class="breadcrumb-bar">
    <div class="breadcrumb">
        <a href="#" onclick="goToIndex('section-home'); return false;" data-i18n="nav_home">Home</a>
        <span class="sep">›</span>
        <a href="#" onclick="goToIndex('section-services'); return false;" data-i18n="nav_services">Services</a>
        <span class="sep">›</span>
        <span class="current" data-i18n="breadcrumb_current">Litigation &amp; Legal Representation</span>
    </div>
</div>

<!-- ─── INTRO ─── -->
<section class="lit-intro" id="section-services">
    <div class="inner">
        <div class="lit-intro-grid">
            <div>
                <div class="lit-intro-label" data-i18n="intro_label">Overview</div>
                <h2 class="lit-intro-heading" data-i18n-html="intro_heading">A Proven Record in <cite>High-Value Disputes</cite></h2>
                <div class="h-gap"><i></i><i></i><i></i><i></i></div>
                <p class="lit-intro-text" data-i18n="intro_p1">Mr. Hoxha, with 23 years of professional experience including a significant tenure as Manager of the Legal Office for Kosovo's Transmission System and Market Operator (KOSTT), has a formidable track record in high-stakes legal representation.</p>
                <p class="lit-intro-text" data-i18n-html="intro_p2">Strategic management of a core team of lawyers resulted in documented savings of approximately <strong style="color:var(--gold);">65 million euros</strong> by successfully preventing liabilities through won cases in both local and international disputes.</p>
                <p class="lit-intro-text" data-i18n="intro_p3">As a member of the Kosovo Bar Association and a certified attorney, his expertise spans commercial, civil, and administrative law — including specialized roles such as serving on the Dispute Settlement Advisory Committee to the Ministerial Council of the Energy Community.</p>
            </div>
            <div>
                <div class="lit-stat-row">
                    <div class="lit-stat">
                        <div class="lit-stat-num">23+</div>
                        <div class="lit-stat-label" data-i18n="stat1_label">Years of Experience</div>
                    </div>
                    <div class="lit-stat">
                        <div class="lit-stat-num">€65M</div>
                        <div class="lit-stat-label" data-i18n="stat2_label">Liabilities Prevented</div>
                    </div>
                    <div class="lit-stat">
                        <div class="lit-stat-num">3</div>
                        <div class="lit-stat-label" data-i18n="stat3_label">Legal Domains</div>
                    </div>
                    <div class="lit-stat">
                        <div class="lit-stat-num">KBA</div>
                        <div class="lit-stat-label" data-i18n="stat4_label">Bar Association Member</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ─── TRACK RECORD BAR ─── -->
<div class="track-record-bar">
    <div class="inner">
        <div class="track-record-icon">⚖️</div>
        <div class="track-record-content">
            <h3 data-i18n-html="track_title">Dispute Settlement Advisory Committee — <cite>Energy Community</cite></h3>
            <p data-i18n="track_text">Mr. Hoxha has served on the Dispute Settlement Advisory Committee to the Ministerial Council of the Energy Community. This extensive background combines deep academic foundations in civil law with practical, high-pressure experience representing enterprises in complex litigation and regulatory proceedings.</p>
        </div>
    </div>
</div>

<!-- ─── SERVICES ─── -->
<!-- ─── SERVICES LITIGATION ─── -->
<section class="services-cta">
    <div class="cta-inner">
        <h2 data-i18n="cta_title">Learn More About Our Services</h2>
        <p data-i18n="cta_text">
            Discover our full range of legal services and expertise tailored for complex business needs.
        </p>
        <a href="/services/VHlex" class="cta-btn" data-i18n="cta_btn">
            Explore Services →
        </a>
    </div>
</section>

<!-- ─── QUALIFICATIONS ─── -->
<section class="lit-qualifications">
    <div class="inner">
        <div class="qual-grid">
            <div>
                <div class="qual-label" data-i18n="qual_label">Background &amp; Credentials</div>
                <h2 class="qual-heading" data-i18n-html="qual_heading">Academic Foundations &amp; <cite>Proven Practice</cite></h2>
                <div class="qual-hgap"><i></i><i></i><i></i><i></i></div>
                <p class="qual-text" data-i18n="qual_p1">This extensive background combines deep academic foundations in civil law with practical, high-pressure experience representing enterprises in complex litigation and regulatory proceedings across local and international forums.</p>
                <p class="qual-text" data-i18n="qual_p2">The combination of institutional leadership at KOSTT and active bar membership creates a unique perspective — understanding both the operational realities of energy enterprises and the legal frameworks that govern them.</p>
                <ul class="qual-list">
                    <li data-i18n="qual_li1">Member of the Kosovo Bar Association — certified attorney at law</li>
                    <li data-i18n="qual_li2">23+ years of professional legal experience in energy and commercial law</li>
                    <li data-i18n="qual_li3">Former Manager, Legal Office — KOSTT (Kosovo TSO &amp; Market Operator)</li>
                    <li data-i18n="qual_li4">Member, Dispute Settlement Advisory Committee — Ministerial Council of the Energy Community</li>
                    <li data-i18n="qual_li5">Expertise in commercial, civil, and administrative law proceedings</li>
                    <li data-i18n="qual_li6">Documented track record: ~€65 million in liabilities successfully prevented</li>
                </ul>
            </div>
            <div class="qual-sidebar">
                <div class="qual-card">
                    <div class="qual-card-title" data-i18n="qcard1_title">Kosovo Bar Association</div>
                    <div class="qual-card-text" data-i18n="qcard1_text">Certified member of the Kosovo Bar Association with full attorney-at-law status, authorized to represent clients in all courts and proceedings in Kosovo and beyond.</div>
                </div>
                <div class="qual-card">
                    <div class="qual-card-title" data-i18n="qcard2_title">KOSTT Legal Office</div>
                    <div class="qual-card-text" data-i18n="qcard2_text">Significant tenure as Manager of the Legal Office for Kosovo's Transmission System and Market Operator — overseeing all legal matters for a critical national infrastructure entity.</div>
                </div>
                <div class="qual-card">
                    <div class="qual-card-title" data-i18n="qcard3_title">Energy Community</div>
                    <div class="qual-card-text" data-i18n="qcard3_text">Served on the Dispute Settlement Advisory Committee to the Ministerial Council of the Energy Community — the highest-level regulatory body for energy in the Western Balkans region.</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ─── CTA ─── -->
<section class="lit-cta">
    <div class="inner">
        <div class="lit-cta-label" data-i18n="cta_label">Get In Touch</div>
        <h2 data-i18n-html="cta_heading">Ready to discuss your <cite>legal matter?</cite></h2>
        <p data-i18n="cta_text">Whether you are facing a complex commercial dispute, a regulatory proceeding, or require strategic legal counsel — our team is ready to assess your case and develop a tailored representation strategy.</p>
        <a href="#" onclick="goToIndex('section-contact'); return false;" class="btn" data-i18n="cta_btn">Schedule a Consultation</a>
    </div>
</section>
