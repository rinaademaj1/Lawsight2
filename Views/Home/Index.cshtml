    </style>
<script>
    /* ════════════════════════════════════════
   INDEX.JS — vetëm për index.html
════════════════════════════════════════ */

    /* ── SLIDER ── */
    const slides = document.querySelectorAll('.slide');
    const dots = document.querySelectorAll('.dot');
    let current = 0;
    let timer;

    function goTo(n) {
        slides[current].classList.remove('active');
        dots[current].classList.remove('active');
        slides[current].querySelectorAll('.layer-eyebrow,.layer-title,.layer-btn').forEach(el => {
            el.style.animation = 'none';
            el.offsetHeight;
            el.style.animation = '';
        });
        current = (n + slides.length) % slides.length;
        slides[current].classList.add('active');
        dots[current].classList.add('active');
    }

    function startTimer() {
        clearInterval(timer);
        timer = setInterval(() => goTo(current + 1), 9000);
    }

    document.getElementById('next-btn').addEventListener('click', () => { goTo(current + 1); startTimer(); });
    document.getElementById('prev-btn').addEventListener('click', () => { goTo(current - 1); startTimer(); });
    dots.forEach(d => d.addEventListener('click', () => { goTo(+d.dataset.index); startTimer(); }));
    startTimer();

    /* ── COUNTER ── */
    function animateCount(el, target, suffix) {
        let start = 0;
        const step = Math.ceil(target / 60);
        const interval = setInterval(() => {
            start += step;
            if (start >= target) { start = target; clearInterval(interval); }
            el.textContent = start + suffix;
        }, 30);
    }

    const statsObserver = new IntersectionObserver(entries => {
        entries.forEach(e => {
            if (!e.isIntersecting) return;
            e.target.querySelectorAll('[data-target]').forEach(n => {
                const t = +n.dataset.target;
                const suffix = n.textContent.includes('+') ? '+' : '';
                animateCount(n, t, suffix);
            });
            statsObserver.unobserve(e.target);
        });
    }, { threshold: 0.3 });

    const statsSection = document.querySelector('.stats-section');
    if (statsSection) statsObserver.observe(statsSection);

    /* ── NAVIGATION HELPER ── */
    function goToIndex(section) {
        const lang = localStorage.getItem('enerlex_lang') || 'EN';
        const hash = section ? '#' + section : '';
        window.location.href = 'index.html?lang=' + lang + hash;
    }

    /* ── SCROLL REVEAL ── */
    const revealObserver = new IntersectionObserver(entries => {
        entries.forEach(e => {
            if (e.isIntersecting) {
                e.target.style.opacity = '1';
                e.target.style.transform = 'translateY(0)';
            }
        });
    }, { threshold: 0.1 });

    document.querySelectorAll('.service-card, .fancybox-item, .stat-item').forEach((el, i) => {
        el.style.opacity = '0';
        el.style.transform = 'translateY(28px)';
        el.style.transition = `opacity 0.6s ${i * 0.08}s ease, transform 0.6s ${i * 0.08}s ease`;
        revealObserver.observe(el);
    });
</script>