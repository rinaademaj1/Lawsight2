            <div class="svc-tags-row">
                <span class="tag" data-i18n="svc2_tag1">Contract Review</span>
                <span class="tag" data-i18n="svc2_tag2">Legal Documentation</span>
                <span class="tag" data-i18n="svc2_tag3">Investor Agreements</span>
                <span class="tag" data-i18n="svc2_tag4">Local Enterprises</span>
                <span class="tag" data-i18n="svc2_tag5">International Business</span>
            </div>
            <a href="#section-contact" class="btn svc-cta-btn" data-i18n="cta_btn">Request This Service</a>
        </div>
        <div class="svc-detail-media">
            <div class="svc-detail-media-frame">
                <img src="~/img/foto5.jpg" alt="Negotiation and Review of Contracts" />
                <div class="svc-media-badge"><span class="badge-num">02</span></div>
            </div>
        </div>
    </div>
</section>

<div class="svc-divider-line"></div>

<!-- ─── SERVICE 3: LEGAL ANALYSIS ─── -->
<section id="svc-legal-analysis" class="svc-detail-section">
    <div class="svc-detail-inner">
        <div class="svc-detail-media">
            <div class="svc-detail-media-frame">
                <img src="~/img/foto4.jpg" alt="Legal Analysis" />
                <div class="svc-media-badge"><span class="badge-num">03</span></div>
            </div>
        </div>
        <div class="svc-detail-body">
            <div class="svc-detail-tag" data-i18n="svc3_tag">Service 03</div>
