@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- ─── SERVICES HERO ─── -->
<section id="section-services-hero" class="svc-hero">
    <div class="svc-hero-bg"><img src="~/img/foto10.jpg" alt=""></div>
    <div class="svc-hero-overlay"></div>
    <div class="svc-hero-content">
        <div class="svc-hero-eyebrow" data-i18n="hero_eyebrow">Our Services</div>
        <h1 class="svc-hero-title" data-i18n-html="hero_title">Consulting &amp;<br /><cite>Legal Expertise</cite></h1>
        <div class="svc-hero-divider"><i></i><i></i><i></i><i></i></div>
        <p class="svc-hero-sub" data-i18n="hero_sub">Consulting and drafting of acts, negotiation and review of contracts, legal analysis.</p>
        <div class="svc-nav-pills">
            <a href="#svc-drafting" class="pill" data-i18n="pill1">Consulting &amp; Drafting of Acts</a>
            <a href="#svc-negotiation" class="pill" data-i18n="pill2">Negotiation &amp; Review of Contracts</a>
            <a href="#svc-legal-analysis" class="pill" data-i18n="pill3">Legal Analysis</a>
        </div>
    </div>
</section>

<!-- ─── FANCYBOX SUMMARY ─── -->
<section class="fancybox-section">
    <div class="fancybox-inner">
        <div class="fancybox-item">
            <div class="fancybox-icon">📝</div>
            <div class="fancybox-content">
                <h3 data-i18n="fancy1_title">Consulting &amp; Drafting of Acts</h3>
                <p data-i18n="fancy1_text">Consulting and drafting of internal regulatory acts of local and international enterprises, investors and business entities.</p>
                <a href="#svc-drafting" class="pill-sm" data-i18n="explore1">Explore →</a>
            </div>
        </div>
        <div class="fancybox-item">
            <div class="fancybox-icon">🤝</div>
            <div class="fancybox-content">
                <h3 data-i18n="fancy2_title">Negotiation &amp; Review of Contracts</h3>
                <p data-i18n="fancy2_text">Negotiation and review of contracts, reports and other documentation of local and international enterprises, investors and business entities.</p>
                <a href="#svc-negotiation" class="pill-sm" data-i18n="explore2">Explore →</a>
            </div>
        </div>
        <div class="fancybox-item">
            <div class="fancybox-icon">⚖️</div>
            <div class="fancybox-content">
                <h3 data-i18n="fancy3_title">Legal Analysis</h3>
                <p data-i18n="fancy3_text">Legal analysis of various legal issues and disputes and presentation of recommendations.</p>
                <a href="#svc-legal-analysis" class="pill-sm" data-i18n="explore3">Explore →</a>
            </div>
        </div>
    </div>
</section>

<!-- ─── SERVICE 1: CONSULTING & DRAFTING OF ACTS ─── -->
<section id="svc-drafting" class="svc-detail-section">
    <div class="svc-detail-inner">
        <div class="svc-detail-media">
            <div class="svc-detail-media-frame">
                <img src="~/img/foto6.jpg" alt="Consulting and Drafting of Acts" />
                <div class="svc-media-badge"><span class="badge-num">01</span></div>
            </div>
        </div>
        <div class="svc-detail-body">
            <div class="svc-detail-tag" data-i18n="svc1_tag">Service 01</div>
            <h2 class="svc-detail-title" data-i18n-html="svc1_title">Consulting &amp; Drafting<br /><cite>of Acts</cite></h2>
            <div class="svc-detail-divider"><i></i><i></i><i></i><i></i></div>
            <p class="svc-detail-lead" data-i18n="svc1_lead">Consulting and drafting of internal regulatory acts of local and international enterprises, investors and business entities.</p>
            <div class="svc-tags-row">
                <span class="tag" data-i18n="svc1_tag1">Internal Regulatory Acts</span>
                <span class="tag" data-i18n="svc1_tag2">Corporate Bylaws</span>
                <span class="tag" data-i18n="svc1_tag3">Compliance Policies</span>
                <span class="tag" data-i18n="svc1_tag4">Governance Charters</span>
                <span class="tag" data-i18n="svc1_tag5">Internal Procedures</span>
                <span class="tag" data-i18n="svc1_tag6">International Standards</span>
            </div>
            <a href="#section-contact" class="btn svc-cta-btn" data-i18n="cta_btn">Request This Service</a>
        </div>
    </div>
</section>

<div class="svc-divider-line"></div>

<!-- ─── SERVICE 2: NEGOTIATION & REVIEW OF CONTRACTS ─── -->
<section id="svc-negotiation" class="svc-detail-section svc-reverse">
