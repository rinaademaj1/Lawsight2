<style>
    /* ─── SERVICES SECTION ─── */
    .services-section {
        background-image: url('/img/foto10.jpg');
        background-position: center;
        background-size: cover;
        background-attachment: fixed;
        position: relative;
    }

        .services-section::before {
            content: '';
            position: absolute;
            inset: 0;
            background: rgba(0,0,0,0.85);
        }

        .services-section .inner {
            position: relative;
            z-index: 1;
            max-width: 1200px;
            margin: 0 auto;
            padding-top: 100px;
            padding-bottom: 100px;
            padding-left: 60px;
            padding-right: 60px;
        }

    .section-heading {
        text-align: center;
        margin-bottom: 60px;
    }

        .section-heading .sub {
            font-size: 0.7rem;
            font-weight: 500;
            letter-spacing: 5px;
            text-transform: uppercase;
            color: var(--gold);
            margin-bottom: 14px;
        }

        .section-heading h2 {
            font-family: 'Playfair Display', serif;
            font-size: clamp(1.8rem, 3vw, 2.6rem);
            font-weight: 700;
            color: var(--white);
            line-height: 1.3;
            margin-bottom: 20px;
        }

            .section-heading h2 cite {
                font-style: italic;
                color: var(--gold);
                font-weight: 400;
            }

    .h-gap {
        display: flex;
        gap: 6px;
        justify-content: center;
    }

        .h-gap i {
            display: block;
            height: 2px;
            background: var(--gold);
            border-radius: 2px;
        }

            .h-gap i:nth-child(1) {
                width: 32px;
            }

            .h-gap i:nth-child(2) {
                width: 8px;
            }

            .h-gap i:nth-child(3) {
                width: 8px;
            }

            .h-gap i:nth-child(4) {
                width: 8px;
            }

    /* ─── GRID ─── */
    .services-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2px;
        background: rgba(61,59,59,0.4);
        grid-auto-rows: 1fr; /* ← TË GJITHA RRESHTAT NJËJTË LARTËSI */
    }

    /* ─── CARD ─── */
    .service-card {
        background: var(--dark);
        border: 1px solid var(--border);
        padding: 40px 34px;
        position: relative;
        overflow: hidden;
        transition: border-color 0.3s;
        cursor: default;
        display: flex;
        flex-direction: column;
    }

        .service-card:hover {
            border-color: var(--gold);
        }

        .service-card::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 0;
            height: 3px;
            background: var(--gold);
            transition: width 0.4s ease;
        }

        .service-card:hover::after {
            width: 100%;
        }

    .service-card-hover {
        position: absolute;
        inset: 0;
        opacity: 0;
        overflow: hidden;
        transition: opacity 0.5s ease;
        z-index: 0;
    }

        .service-card-hover img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            display: block;
        }

        .service-card-hover::after {
            content: '';
            position: absolute;
            inset: 0;
            background: rgba(0,0,0,0.72);
        }

    .service-card:hover .service-card-hover {
        opacity: 1;
    }

    .service-card-body {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .service-icon {
        font-size: 2.2rem;
        margin-bottom: 20px;
        background: linear-gradient(135deg, var(--gold), var(--gold-hover));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .service-card h3 {
        font-family: 'Poppins', sans-serif;
        font-size: 1rem;
        font-weight: 600;
        color: var(--white);
        margin-bottom: 12px;
        line-height: 1.4;
    }

    .service-card p {
        font-size: 0.82rem;
        line-height: 1.8;
        color: var(--text-muted);
        flex: 1;
    }

    .service-card-cta {
        display: inline-block;
        margin-top: 20px;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--gold);
        text-decoration: none;
        opacity: 0;
        transition: opacity 0.3s;
    }

    .service-card:hover .service-card-cta {
        opacity: 1;
    }

    /* ─── 23+ CARD ─── */
    .card-gold {
        background: rgba(213,170,109,0.06);
        align-items: center;
        justify-content: center;
        text-align: center;
    }

        .card-gold .service-card-body {
            align-items: center;
            justify-content: center;
        }

    .gold-num {
        font-family: 'Playfair Display', serif;
        font-size: 2.4rem;
        font-weight: 400;
        color: var(--gold);
        margin-bottom: 12px;
        font-style: italic;
    }

    .gold-label {
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: #777;
        margin-bottom: 30px;
    }

    .btn-sm {
        font-size: 0.7rem;
        padding: 12px 28px;
    }

    /* ─── SCROLL TOP ─── */
    .scroll-top {
        position: fixed;
        bottom: 36px;
        right: 36px;
        width: 46px;
        height: 46px;
        background: var(--gold);
        color: var(--dark);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        text-decoration: none;
        z-index: 999;
        opacity: 0;
        transition: opacity 0.3s;
    }

        .scroll-top.show {
            opacity: 1;
        }
</style>

