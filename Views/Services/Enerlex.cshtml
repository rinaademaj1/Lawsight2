            btn_consult_now: "Konsulto Tani"
        }
    };

    /* ── APPLY TRANSLATIONS ── */
    function applyPageTranslations(lang) {
        const t = svcTranslations[lang];
        if (!t) return;
        document.querySelectorAll('[data-i18n]').forEach(el => {
            const key = el.getAttribute('data-i18n');
            if (t[key] !== undefined) el.textContent = t[key];
        });
        document.querySelectorAll('[data-i18n-html]').forEach(el => {
            const key = el.getAttribute('data-i18n-html');
            if (t[key] !== undefined) el.innerHTML = t[key];
        });
    }

    /* ── INIT — lexo gjuhën nga shared.js ── */
    const initLang = localStorage.getItem('enerlex_lang') || 'EN';
    applyPageTranslations(initLang);

    /* ── DËGJO NDRYSHIMIN E GJUHËS nga shared.js ── */
    const _origSetLangUI = window.setLangUI;
    window.setLangUI = function (code) {
        if (_origSetLangUI) _origSetLangUI(code);
        applyPageTranslations(code);
    };

    /* ── SCROLL REVEAL ── */
    const revealObserver = new IntersectionObserver(entries => {
        entries.forEach(e => {
            if (e.isIntersecting) {
                e.target.style.opacity = '1';
                e.target.style.transform = 'translateY(0)';
            }
        });
    }, { threshold: 0.1 });

    document.querySelectorAll('.service-card').forEach((el, i) => {
        el.style.opacity = '0';
        el.style.transform = 'translateY(28px)';
        el.style.transition = `opacity 0.6s ${i * 0.08}s ease, transform 0.6s ${i * 0.08}s ease`;
        revealObserver.observe(el);
    });
</script>