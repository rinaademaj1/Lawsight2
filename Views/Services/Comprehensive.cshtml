@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- ─── SERVICES HERO ─── -->
<section id="section-services-hero" class="svc-hero">
    <div class="svc-hero-bg"><img src="~/img/foto10.jpg" alt=""></div>
    <div class="svc-hero-overlay"></div>
    <div class="svc-hero-content">
        <div class="svc-hero-eyebrow" data-i18n="hero_eyebrow">Shërbimet Tona</div>
        <h1 class="svc-hero-title" data-i18n-html="hero_title">Konsulencë &amp;<br /><cite>Ekspertizë Ligjore</cite></h1>
        <div class="svc-hero-divider"><i></i><i></i><i></i><i></i></div>
        <p class="svc-hero-sub" data-i18n="hero_sub">Studime fizibiliteti, negocim kontratash dhe hartim rregullator për ndërmarrjet lokale dhe ndërkombëtare.</p>
        <div class="svc-nav-pills">
            <a href="#svc-due-diligence" class="pill" data-i18n="pill1">Due Diligence Ligjore Gjithëpërfshirëse</a>
        </div>
    </div>
</section>

<!-- ─── FANCYBOX SUMMARY ─── -->
<section class="fancybox-section">
    <div class="fancybox-inner">
        <div class="fancybox-item">
            <div class="fancybox-icon">⚖️</div>
            <div class="fancybox-content">
                <h3 data-i18n="fancy1_title">Due Diligence Ligjore Gjithëpërfshirëse &amp; Vlerësim Rreziku</h3>
                <p data-i18n="fancy1_text">Kryejmë due diligence ligjore gjithëpërfshirëse për infrastrukturë të mëdha energjetike, ristrukturim institucional dhe projekte ndërkufitare.</p>
                <a href="#svc-due-diligence" class="pill-sm" data-i18n="explore">Eksploro →</a>
            </div>
        </div>
    </div>
</section>

<!-- ─── SERVICE 11: COMPREHENSIVE LEGAL DUE DILIGENCE & RISK ASSESSMENT ─── -->
<section id="svc-due-diligence" class="svc-detail-section">
    <div class="svc-detail-inner">
        <div class="svc-detail-media">
            <div class="svc-detail-media-frame">
                <img src="~/img/foto6.jpg" alt="Due Diligence Ligjore Gjithëpërfshirëse dhe Vlerësim Rreziku" />
                <div class="svc-media-badge"><span class="badge-num">01</span></div>
            </div>
        </div>
        <div class="svc-detail-body">
            <div class="svc-detail-tag" data-i18n="svc_tag">Shërbimi 01</div>
            <h2 class="svc-detail-title" data-i18n-html="svc_title">Due Diligence Ligjore Gjithëpërfshirëse &amp;<br /><cite>Vlerësim Rreziku</cite></h2>
            <div class="svc-detail-divider"><i></i><i></i><i></i><i></i></div>
            <p class="svc-detail-lead" data-i18n="svc_lead">Kryerja e due diligence ligjore gjithëpërfshirëse për infrastrukturë të mëdha energjetike, ristrukturim institucional dhe projekte ndërkufitare.</p>
            <p class="svc-detail-body-text" data-i18n="svc_body">Shfrytëzojmë 23 vjet përvojë për të identifikuar rreziqet rregullatore dhe operacionale, duke siguruar që projektet plotësojnë kërkesat strikte të institucioneve ndërkombëtare financiare (KfW, BERZH, Banka Botërore) dhe organeve rregullatore rajonale. Procesi ynë i due diligence është gjithëpërfshirës, i strukturuar dhe plotësisht i harmonizuar me standardet e pritshme nga institucionet kryesore botërore të financimit për zhvillim — duke u dhënë investitorëve dhe sponsorëve të projekteve besimin për të vazhduar me qartësi dhe siguri ligjore.</p>
            <div class="svc-tags-row">
                <span class="tag" data-i18n="tag1">Due Diligence Ligjore</span>
                <span class="tag" data-i18n="tag2">Vlerësim Rreziku</span>
                <span class="tag" data-i18n="tag3">Infrastrukturë Energjetike</span>
                <span class="tag" data-i18n="tag4">Projekte Ndërkufitare</span>
                <span class="tag" data-i18n="tag5">KfW / BERZH / Banka Botërore</span>
                <span class="tag" data-i18n="tag6">Ristrukturim Institucional</span>
            </div>
            <a href="#section-contact" class="btn svc-cta-btn" data-i18n="cta_btn">Kërkoni Këtë Shërbim</a>
        </div>
    </div>
</section>

<!-- ─── CONTACT ─── -->
<section id="section-contact" class="contact-section">
    <div class="inner">
        <div class="contact-grid">
            <div>
                <div class="contact-sub" data-i18n="contact_sub">Na Kontaktoni</div>
                <h2 class="contact-h2" data-i18n-html="contact_title">Mos hezitoni të na kontaktoni,<br />jemi <cite>këtu</cite> për ju</h2>
                <div class="h-gap" style="margin-top:20px;"><i></i><i></i><i></i><i></i></div>
            </div>
            <div>
                <div class="contact-info-item">
                    <div class="contact-info-icon">📍</div>
                    <div class="contact-info-text">Rr. 'Sylejman Vokshi' nr.17, k.2 nr.5<br />10000 Prishtinë, Kosovë</div>
                </div>
                <div class="contact-info-item">
                    <div class="contact-info-icon">📞</div>
                    <div class="contact-info-text"><a href="tel:+38344308830" style="color:inherit;text-decoration:none;">+383 44 308 830</a></div>
                </div>
                <div class="contact-info-item">
                    <div class="contact-info-icon">🌐</div>
                    <div class="contact-info-text">www.enerlex-ks.com</div>
                </div>
            </div>
        </div>
        <div class="contact-form">
            <div class="form-row">
                <input type="text" class="form-input" data-i18n-placeholder="placeholder_firstname" placeholder="Emri.." />
                <input type="text" class="form-input" data-i18n-placeholder="placeholder_lastname" placeholder="Mbiemri.." />
                <input type="email" class="form-input" data-i18n-placeholder="placeholder_email" placeholder="Adresa Email.." />
            </div>
            <textarea class="form-input form-textarea" data-i18n-placeholder="placeholder_message" placeholder="Mesazhi.."></textarea>
            <button class="btn-submit" type="button" data-i18n="btn_send">Dërgo</button>
        </div>
    </div>
</section>

<a href="#section-services-hero" class="scroll-top" id="scroll-top">↑</a>

