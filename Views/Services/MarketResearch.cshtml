    .contact-sub {
        font-size: 0.7rem;
        font-weight: 500;
        letter-spacing: 5px;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: 14px;
    }

    .contact-h2 {
        font-family: 'Playfair Display', serif;
        font-size: clamp(1.6rem, 2.8vw, 2.2rem);
