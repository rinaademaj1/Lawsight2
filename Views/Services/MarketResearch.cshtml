<style>
    /* ─── HERO ─── */
    .svc-hero {
        position: relative;
        width: 100%;
        height: 70vh;
        min-height: 520px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .svc-hero-bg { position: absolute; inset: 0; }

    .svc-hero-bg img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        display: block;
    }

    .svc-hero-overlay {
        position: absolute;
        inset: 0;
        background: rgba(10,8,6,0.78);
    }

    .svc-hero-content {
        position: relative;
        z-index: 5;
        text-align: center;
        max-width: 860px;
        padding: 0 40px;
    }

    .svc-hero-eyebrow {
        font-family: 'Poppins', sans-serif;
        font-size: 0.75rem;
        font-weight: 400;
        letter-spacing: 6px;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: 18px;
    }

    .svc-hero-title {
        font-family: 'Poppins', sans-serif;
        font-size: clamp(2rem, 5vw, 3.6rem);
        font-weight: 600;
        line-height: 1.2;
        color: var(--white);
        margin-bottom: 20px;
    }

    .svc-hero-title cite {
        font-style: italic;
        font-family: 'Playfair Display', serif;
        color: var(--gold);
        font-weight: 400;
    }

    .svc-hero-divider {
        display: flex;
        gap: 6px;
        justify-content: center;
        margin-bottom: 20px;
    }

    .svc-hero-divider i { display: block; height: 2px; background: var(--gold); border-radius: 2px; }
    .svc-hero-divider i:nth-child(1) { width: 32px; }
    .svc-hero-divider i:nth-child(2) { width: 8px; }
    .svc-hero-divider i:nth-child(3) { width: 8px; }
    .svc-hero-divider i:nth-child(4) { width: 8px; }

    .svc-hero-sub {
        font-family: 'Open Sans', sans-serif;
        font-size: 0.9rem;
        line-height: 1.8;
        color: rgba(255,255,255,0.6);
        margin-bottom: 36px;
    }

    .svc-nav-pills {
        display: flex;
        gap: 12px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .pill {
        display: inline-block;
        padding: 10px 24px;
        border: 1px solid var(--gold);
        color: var(--gold);
        font-family: 'Poppins', sans-serif;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
        text-decoration: none;
        transition: all 0.3s;
    }

    .pill:hover { background: var(--gold); color: var(--dark); }

    /* ─── FANCYBOX ─── */
    .fancybox-section {
        background: var(--dark);
        background-image: url('/img/foto9.jpg');
        background-size: cover;
        background-position: center;
        position: relative;
    }

    .fancybox-section::before {
        content: '';
        position: absolute;
        inset: 0;
        background: rgba(18,13,11,0.9);
    }

    .fancybox-inner {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: repeat(3,1fr);
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 60px;
    }

    .fancybox-item {
        padding: 52px 40px;
        border-right: 1px solid var(--border);
        display: flex;
        gap: 24px;
        align-items: flex-start;
        transition: background 0.3s;
    }

    .fancybox-item:last-child { border-right: none; }
    .fancybox-item:hover { background: rgba(213,170,109,0.06); }

    .fancybox-icon {
        width: 60px;
        height: 60px;
        flex-shrink: 0;
        background: linear-gradient(135deg, var(--gold) 0%, var(--gold-hover) 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }

    .fancybox-content h3 {
        font-family: 'Poppins', sans-serif;
        font-size: 1rem;
        font-weight: 600;
        color: var(--white);
        margin-bottom: 10px;
        line-height: 1.4;
    }

    .fancybox-content p {
        font-family: 'Open Sans', sans-serif;
        font-size: 0.82rem;
        line-height: 1.75;
        color: var(--text-muted);
        margin-bottom: 14px;
    }

    .pill-sm {
        display: inline-block;
        font-family: 'Poppins', sans-serif;
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--gold);
        text-decoration: none;
        border-bottom: 1px solid transparent;
        transition: border-color 0.3s;
    }

    .pill-sm:hover { border-color: var(--gold); }

    /* ─── SERVICE DETAIL ─── */
    .svc-detail-section {
        background: var(--dark);
        padding: 100px 60px;
        position: relative;
    }

    .svc-detail-section::before {
        content: '';
        position: absolute;
        inset: 0;
        background: rgba(0,0,0,0.6);
        pointer-events: none;
    }

    .svc-detail-inner {
        position: relative;
        z-index: 1;
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 80px;
        align-items: center;
    }

    .svc-detail-media-frame {
        position: relative;
        overflow: hidden;
    }

    .svc-detail-media-frame img {
        width: 100%;
        height: 460px;
        object-fit: cover;
        display: block;
        filter: brightness(0.85);
        transition: filter 0.4s;
    }

    .svc-detail-media-frame:hover img { filter: brightness(1); }

    .svc-media-badge {
        position: absolute;
        bottom: 24px;
        left: 24px;
        width: 64px;
        height: 64px;
        background: var(--gold);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .badge-num {
        font-family: 'Playfair Display', serif;
        font-size: 1.4rem;
        font-weight: 400;
        color: var(--dark);
    }

    .svc-detail-tag {
        font-family: 'Poppins', sans-serif;
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 5px;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: 16px;
    }

    .svc-detail-title {
        font-family: 'Playfair Display', serif;
        font-size: clamp(2rem, 3.5vw, 3rem);
        font-weight: 700;
        color: var(--white);
        line-height: 1.2;
        margin-bottom: 20px;
    }

    .svc-detail-title cite {
        font-style: italic;
        color: var(--gold);
        font-weight: 400;
    }

    .svc-detail-divider {
        display: flex;
        gap: 6px;
        margin-bottom: 28px;
    }

    .svc-detail-divider i { display: block; height: 2px; background: var(--gold); border-radius: 2px; }
    .svc-detail-divider i:nth-child(1) { width: 32px; }
    .svc-detail-divider i:nth-child(2) { width: 8px; }
    .svc-detail-divider i:nth-child(3) { width: 8px; }
    .svc-detail-divider i:nth-child(4) { width: 8px; }

    .svc-detail-lead {
        font-family: 'Poppins', sans-serif;
        font-size: 1rem;
        font-weight: 500;
        color: rgba(255,255,255,0.85);
        line-height: 1.7;
        margin-bottom: 16px;
    }

    .svc-detail-body-text {
        font-family: 'Open Sans', sans-serif;
        font-size: 0.86rem;
        line-height: 1.85;
        color: var(--text-muted);
        margin-bottom: 28px;
    }

    .svc-tags-row {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 32px;
    }

    .tag {
        display: inline-block;
        padding: 6px 14px;
        border: 1px solid rgba(213,170,109,0.35);
        font-family: 'Poppins', sans-serif;
        font-size: 0.68rem;
        font-weight: 500;
        letter-spacing: 1px;
        color: rgba(213,170,109,0.8);
        text-transform: uppercase;
    }

    .svc-cta-btn { display: inline-block; text-decoration: none; }

    .svc-divider-line {
        height: 1px;
        background: rgba(213,170,109,0.15);
        max-width: 1200px;
        margin: 0 auto;
    }

    /* ─── CONTACT ─── */
    .contact-section {
        background-image: url('/img/foto12.jpg');
        background-position: center;
        background-size: cover;
        background-attachment: fixed;
        position: relative;
    }

    .contact-section::before {
        content: '';
        position: absolute;
        inset: 0;
        background: rgba(0,0,0,0.82);
    }

    .contact-section .inner {
        position: relative;
        z-index: 1;
