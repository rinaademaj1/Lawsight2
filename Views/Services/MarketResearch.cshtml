<!-- ─── SERVICE 1: FEASIBILITY STUDIES ─── -->
<section id="svc-feasibility" class="svc-detail-section">
    <div class="svc-detail-inner">
        <div class="svc-detail-media">
            <div class="svc-detail-media-frame">
                <img src="~/img/foto4.jpg" alt="Feasibility Studies" />
                <div class="svc-media-badge">
                    <span class="badge-num">01</span>
                </div>
            </div>
        </div>
        <div class="svc-detail-body">
            <div class="svc-detail-tag">Service 01</div>
            <h2 class="svc-detail-title">Feasibility<br /><cite>Studies</cite></h2>
            <div class="svc-detail-divider"><i></i><i></i><i></i><i></i></div>
            <p class="svc-detail-lead">Feasibility studies and technical consulting services in the field of trade law, commercial law, property, energy, ethics and institutional integrity, employment and human resources.</p>
            <p class="svc-detail-body-text">We deliver comprehensive feasibility assessments that evaluate the legal, regulatory and commercial viability of projects before investment decisions are made. Our studies integrate technical consulting with deep sector knowledge, ensuring clients have a clear and accurate picture of opportunities, constraints and compliance requirements across all relevant areas of law.</p>
            <div class="svc-tags-row">
                <span class="tag">Trade Law</span>
                <span class="tag">Commercial Law</span>
                <span class="tag">Property</span>
                <span class="tag">Energy</span>
                <span class="tag">Ethics &amp; Integrity</span>
                <span class="tag">Human Resources</span>
            </div>
            <a href="#section-contact" class="btn svc-cta-btn">Request This Service</a>
        </div>
    </div>
</section>

<!-- ─── DIVIDER ─── -->
<div class="svc-divider-line"></div>

<!-- ─── SERVICE 2: NEGOTIATION & CONTRACTS ─── -->
<section id="svc-contracts" class="svc-detail-section svc-reverse">
    <div class="svc-detail-inner">
        <div class="svc-detail-body">
            <div class="svc-detail-tag">Service 02</div>
            <h2 class="svc-detail-title">Negotiation &amp; Review<br /><cite>of Contracts</cite></h2>
            <div class="svc-detail-divider"><i></i><i></i><i></i><i></i></div>
            <p class="svc-detail-lead">Negotiation and review of contracts, reports and other documentation of local and international enterprises, investors and business entities.</p>
            <p class="svc-detail-body-text">We provide expert negotiation support and rigorous review of commercial contracts, institutional agreements and investment documentation. Our team ensures every document is legally sound, commercially balanced and aligned with the client's strategic objectives — whether dealing with domestic partners or complex cross-border arrangements involving multiple jurisdictions.</p>
            <div class="svc-tags-row">
                <span class="tag">Contract Negotiation</span>
                <span class="tag">Document Review</span>
                <span class="tag">International Agreements</span>
                <span class="tag">Investor Documentation</span>
                <span class="tag">Cross-Border</span>
            </div>
            <a href="#section-contact" class="btn svc-cta-btn">Request This Service</a>
        </div>
        <div class="svc-detail-media">
            <div class="svc-detail-media-frame">
                <img src="~/img/foto5.jpg" alt="Negotiation and Contracts" />
                <div class="svc-media-badge">
                    <span class="badge-num">02</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ─── DIVIDER ─── -->
<div class="svc-divider-line"></div>

<!-- ─── SERVICE 3: CONSULTING & DRAFTING ─── -->
<section id="svc-drafting" class="svc-detail-section">
    <div class="svc-detail-inner">
        <div class="svc-detail-media">
            <div class="svc-detail-media-frame">
                <img src="~/img/foto6.jpg" alt="Consulting and Drafting" />
                <div class="svc-media-badge">
                    <span class="badge-num">03</span>
                </div>
            </div>
        </div>
        <div class="svc-detail-body">
            <div class="svc-detail-tag">Service 03</div>
            <h2 class="svc-detail-title">Consulting &amp; Drafting<br /><cite>of Acts</cite></h2>
            <div class="svc-detail-divider"><i></i><i></i><i></i><i></i></div>
            <p class="svc-detail-lead">Consulting and drafting of internal regulatory acts of local and international enterprises, investors and business entities.</p>
            <p class="svc-detail-body-text">We assist enterprises and investors in designing and drafting the internal regulatory framework that governs their operations. From corporate bylaws and compliance policies to internal procedures and governance charters, our work ensures every act is legally precise, operationally practical and aligned with applicable national and international standards.</p>
            <div class="svc-tags-row">
                <span class="tag">Regulatory Acts</span>
                <span class="tag">Corporate Bylaws</span>
                <span class="tag">Compliance Policies</span>
                <span class="tag">Governance Charters</span>
                <span class="tag">Internal Procedures</span>
            </div>
            <a href="#section-contact" class="btn svc-cta-btn">Request This Service</a>
        </div>
    </div>
</section>

<!-- ─── DIVIDER ─── -->
<div class="svc-divider-line"></div>

<!-- ─── SERVICE 4: MARKET RESEARCH ─── -->
<section id="svc-market" class="svc-detail-section svc-reverse">
    <div class="svc-detail-inner">
        <div class="svc-detail-body">
            <div class="svc-detail-tag">Service 04</div>
            <h2 class="svc-detail-title">Market<br /><cite>Research</cite></h2>
            <div class="svc-detail-divider"><i></i><i></i><i></i><i></i></div>
            <p class="svc-detail-lead">Market and business environment research, identification of opportunities and risks for operation of local and international enterprises and business entities.</p>
            <p class="svc-detail-body-text">We conduct targeted market research and business environment analysis to support strategic decision-making for enterprises operating locally and internationally. Our assessments identify regulatory risks, competitive dynamics and entry opportunities, giving clients a reliable foundation for expanding operations or entering new markets with confidence.</p>
            <div class="svc-tags-row">
                <span class="tag">Market Analysis</span>
                <span class="tag">Risk Identification</span>
                <span class="tag">Business Environment</span>
                <span class="tag">International Enterprises</span>
                <span class="tag">Strategic Research</span>
            </div>
            <a href="#section-contact" class="btn svc-cta-btn">Request This Service</a>
        </div>
        <div class="svc-detail-media">
            <div class="svc-detail-media-frame">
                <img src="~/img/foto7.jpg" alt="Market Research" />
                <div class="svc-media-badge">
                    <span class="badge-num">04</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ─── DIVIDER ─── -->
<div class="svc-divider-line"></div>

<!-- ─── SERVICE 5: LEGAL RESEARCH & DUE DILIGENCE ─── -->
<section id="svc-legal-research" class="svc-detail-section">
    <div class="svc-detail-inner">
        <div class="svc-detail-media">
            <div class="svc-detail-media-frame">
                <img src="~/img/foto8.jpg" alt="Legal Research and Due Diligence" />
                <div class="svc-media-badge">
                    <span class="badge-num">05</span>
                </div>
            </div>
        </div>
        <div class="svc-detail-body">
            <div class="svc-detail-tag">Service 05</div>
            <h2 class="svc-detail-title">Legal Research &amp;<br /><cite>Due Diligence</cite></h2>
            <div class="svc-detail-divider"><i></i><i></i><i></i><i></i></div>
            <p class="svc-detail-lead">Professional legal research and evaluations due diligence in the field of commercial law, energy, with special emphasis on renewable resources and the electricity market.</p>
            <p class="svc-detail-body-text">We provide thorough legal research and due diligence services covering commercial law, ownership, ethics and institutional integrity, employment and human resources. With particular focus on the energy sector and renewable resources, our work equips clients and investors with the precise legal intelligence needed to make informed decisions and mitigate exposure across all transaction types.</p>
            <div class="svc-tags-row">
                <span class="tag">Commercial Law</span>
                <span class="tag">Energy Sector</span>
                <span class="tag">Renewable Resources</span>
                <span class="tag">Electricity Market</span>
                <span class="tag">Ownership</span>
                <span class="tag">Institutional Integrity</span>
            </div>
            <a href="#section-contact" class="btn svc-cta-btn">Request This Service</a>
        </div>
    </div>
</section>

<!-- ─── DIVIDER ─── -->
<div class="svc-divider-line"></div>

<!-- ─── SERVICE 6: LEGAL ANALYSIS ─── -->
<section id="svc-legal-analysis" class="svc-detail-section svc-reverse">
    <div class="svc-detail-inner">
        <div class="svc-detail-body">
            <div class="svc-detail-tag">Service 06</div>
            <h2 class="svc-detail-title">Legal<br /><cite>Analysis</cite></h2>
            <div class="svc-detail-divider"><i></i><i></i><i></i><i></i></div>
            <p class="svc-detail-lead">Legal analysis of various legal issues and disputes and presentation of recommendations.</p>
            <p class="svc-detail-body-text">We deliver precise legal analysis on complex regulatory, commercial and institutional issues, drawing on over two decades of sector experience. Our analyses go beyond identifying problems — we present structured, actionable recommendations that allow clients to resolve disputes, navigate regulatory uncertainty and make decisions with full legal clarity.</p>
            <div class="svc-tags-row">
                <span class="tag">Legal Issues</span>
                <span class="tag">Dispute Analysis</span>
                <span class="tag">Regulatory Clarity</span>
                <span class="tag">Recommendations</span>
                <span class="tag">Commercial Law</span>
            </div>
            <a href="#section-contact" class="btn svc-cta-btn">Request This Service</a>
        </div>
        <div class="svc-detail-media">
            <div class="svc-detail-media-frame">
                <img src="~/img/foto4.jpg" alt="Legal Analysis" />
                <div class="svc-media-badge">
                    <span class="badge-num">06</span>
                </div>
            </div>
        </div>
    </div>
</section>

